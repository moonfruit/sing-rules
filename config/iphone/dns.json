{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      { "tag": "dns-resolver", "type": "udp", "server": "223.5.5.5" },
      { "tag": "dns-direct", "type": "h3", "server": "dns.alidns.com", "domain_resolver": "dns-resolver" },
      { "tag": "dns-proxy", "type": "h3", "server": "one.one.one.one", "detour": "🔰 默认出口" },
      { "tag": "dns-local", "type": "local" },
      { "tag": "dns-gingkoo", "type": "udp", "server": "10.1.2.59" },
      { "tag": "dns-fakeip", "type": "fakeip", "inet4_range": "22.0.0.0/8" }
    ],
    "rules": [
      { "preferred_by": "dns-local", "server": "dns-local" },
      { "domain_suffix": ["server.gingkoo", "gingkoo.internal"], "server": "dns-gingkoo" },
      { "rule_set": "NoIPv6", "action": "predefined" },
      { "rule_set": "FakeIpBypass", "server": "dns-direct" },
      { "query_type": ["A", "AAAA"], "server": "dns-fakeip", "rewrite_ttl": 1 },
      { "clash_mode": "Direct", "server": "dns-direct" },
      { "clash_mode": "Global", "server": "dns-proxy" },
      { "rule_set": "GeoSites@CN", "server": "dns-direct" },
      { "rule_set": "GeoSites@!CN", "server": "dns-proxy" },
      { "action": "evaluate", "server": "dns-direct" },
      { "match_response": true, "rule_set": "GeoIP@CN", "action": "respond" }
    ],
    "final": "dns-proxy",
    "reverse_mapping": true,
    "strategy": "prefer_ipv6"
  },
  "route": {
    "rules": [
      { "network": "icmp", "preferred_by": "BRIDGE", "outbound": "BRIDGE" },
      { "network": "icmp", "outbound": "DIRECT" },
      { "ip_is_private": true, "preferred_by": "BRIDGE", "outbound": "BRIDGE" },
      { "ip_is_private": true, "outbound": "DIRECT" },
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "tcp", "port": 853 },
              { "protocol": ["http", "tls"], "rule_set": "DoH" }
            ]
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "udp", "port": 853 },
              { "protocol": "quic", "rule_set": "DoH" }
            ]
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      { "protocol": ["bittorrent", "ntp", "stun"], "outbound": "DIRECT" }
    ],
    "default_domain_resolver": "dns-direct"
  }
}
